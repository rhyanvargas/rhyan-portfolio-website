# Required for Payload (admin + Local API). Copy to `.env` and replace the secret.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Local (default): SQLite file DB — no Docker required.
# The Now slice uses @payloadcms/db-sqlite only; a postgres:// URL is not wired yet.
DATABASE_URL=file:./payload.db

# Production (Next/Later): add @payloadcms/db-postgres (or Turso/libsql) before using:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
