# Required for Payload (admin + Local API). Copy to `.env` and replace the secret.
PAYLOAD_SECRET=replace-with-a-long-random-string

# --- Database ---
# Local (default): SQLite file — no Docker required.
DATABASE_URL=file:./payload.db

# Vercel Preview/Production: install Neon Free via Vercel Marketplace.
# Marketplace injects POSTGRES_URL (preferred). Payload uses @payloadcms/db-vercel-postgres
# when POSTGRES_URL or a postgres:// DATABASE_URL is present.
# POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
#
# Optional Turso/libsql (still uses sqlite adapter when no POSTGRES_URL):
# DATABASE_URL=libsql://YOUR-DB.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Public site origin (live preview iframe + preview button links).
# Production: https://www.rhyan.dev  |  Preview: your *.vercel.app URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret for /next/preview (draft Mode). Use a long random string in every env.
PREVIEW_SECRET=replace-with-another-long-random-string

# Authorizes unauthenticated calls to /api/payload-jobs/run (Vercel Cron).
CRON_SECRET=replace-with-cron-bearer-token

# Set to false on Vercel (use Cron → /api/payload-jobs/run instead of in-process autoRun).
# Hobby plans only allow daily crons — vercel.json uses `0 0 * * *` (UTC midnight).
# PAYLOAD_JOBS_AUTORUN=false
